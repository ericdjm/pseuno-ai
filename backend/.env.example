# Spotify OAuth (optional - enables Spotify login/profile)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/auth/spotify/callback

# App Settings
FRONTEND_ORIGIN=http://127.0.0.1:5173
DEBUG=true
SECRET_KEY=change-this-to-a-random-secret-in-production

# Security Settings (optional - auto-configured based on DEBUG)
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_MAX_AGE=86400

# Rate Limiting (optional)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Request Timeouts (optional)
HTTP_TIMEOUT=60

# Storage (optional - defaults for local dev)
REDIS_URL=redis://127.0.0.1:6379/0
# DATABASE_URL=postgresql+psycopg://pseuno:pseuno@127.0.0.1:5432/pseuno
DATABASE_URL=sqlite:///./pseuno.db

# LLM Settings - choose one provider
# OpenAI models (e.g., gpt-5-nano, gpt-5-mini, gpt-5.2)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini models (e.g., gemini-3-flash-preview, gemini-2.5-flash)
# GEMINI_API_KEY=your_gemini_api_key_here

# Model selection (defaults to gpt-5-nano)
# LLM_MODEL=gpt-5-nano
# LLM_MODEL=gemini-3-flash-preview
LLM_TEMPERATURE=0.7
